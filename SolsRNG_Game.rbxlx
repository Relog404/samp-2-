	FastRollCooldown = 0.5,
	AutoRollInterval = 2.2,
	DefaultStorage = 20,
	ExtraStorageBonus = 30,
	MaxStorageLimit = 150,

	CoinsPerRoll = {
		Common = 5,
		Good = 10,
		Rare = 25,
		Epic = 50,
		Legendary = 150,
