--------------------------------------------------------------------------------
-- UI ROOT &amp; UTILITIES
--------------------------------------------------------------------------------

local screenGui = script.Parent
if not screenGui:IsA(&quot;ScreenGui&quot;) then
	screenGui = Instance.new(&quot;ScreenGui&quot;)
